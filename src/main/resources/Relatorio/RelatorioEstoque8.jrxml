	<parameter name="dataInicial" class="java.sql.Date"/>
	<parameter name="dataFinal" class="java.sql.Date"/>
	<query language="SQL"><![CDATA[SELECT 
    e.id AS código,
    a.nome,
    a.categoria,
    a.quantidade,
    e.quanti_usada AS quanti_movimentada,
    e.movimentacao,
    DATE_FORMAT(e.data_ent_sai, '%d/%m/%Y') AS data
FROM 
    estoque e
JOIN 
    alimentos a ON e.id_alimento = a.id
WHERE 
    e.data_ent_sai BETWEEN $P{dataInicial} AND $P{dataFinal}
ORDER BY 
    e.data_ent_sai
]]></query>
